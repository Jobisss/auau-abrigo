# Chave PIX do abrigo — vazio desliga o PIX no app (telefone no formato +55DDDNUMERO, e-mail, CPF/CNPJ ou chave aleatória)
VITE_PIX_KEY=
# Nome e cidade do recebedor (máx. 25 e 15 caracteres, sem acento)
VITE_PIX_MERCHANT_NAME=Abrigo Toca de Assis
VITE_PIX_MERCHANT_CITY=Ivaipora

# --- Servidor (nunca use o prefixo VITE_ aqui: essas não vão pro navegador) ---
# Login do painel do abrigo (/admin). Senha com 8+ caracteres; vazio desativa o login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Porta do servidor em produção (Railway/Fly definem sozinhos). Em dev a API fica sempre na 3001.
# PORT=3001
# Pasta com o banco SQLite e as fotos — é ela que precisa de volume/backup em produção
# DATA_DIR=data
# true quando rodar atrás de proxy (Railway, Fly, nginx) pra ler o IP real no X-Forwarded-For
# TRUST_PROXY=false
