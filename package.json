{
  "name": "ajudando-o-abrigo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,blue \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "PORT=3001 bun --watch server/index.ts",
    "dev:web": "bunx --bun vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && bunx --bun vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "lucide-react": "^1.47.0",
    "mp4-muxer": "^5.2.2",
    "pix-utils": "^2.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
